{
  "id": "a8f9a410-2b5d-4b6e-8c3a-59e1f0a71230",
  "name": "Ingesta Ya Empleo (scraper HTML)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            },
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "schedule-ya",
      "name": "Cada 12 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://www.yaempleo.net/posts",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
            }
          ]
        },
        "options": {
          "response": {
            "responseFormat": "text"
          }
        }
      },
      "id": "get-ya",
      "name": "Descargar listado /posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://buscador-inteligente-de-convocatorias.onrender.com/api/webhook/ingest-html",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "dev-webhook-secret"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'yaempleo', html: $json.body }) }}"
      },
      "id": "post-ya",
      "name": "Enviar al backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 0]
    }
  ],
  "connections": {
    "Cada 12 horas": {
      "main": [[{ "node": "Descargar listado /posts", "type": "main", "index": 0 }]]
    },
    "Descargar listado /posts": {
      "main": [[{ "node": "Enviar al backend", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}