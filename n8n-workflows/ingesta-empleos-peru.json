{
  "name": "Ingesta Empleos Perú (borrador)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "schedule-empleos",
      "name": "Cada 12 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "PLACEHOLDER: URL de la bolsa de empleos a integrar"
      },
      "id": "http-fetch-empleos",
      "name": "Descargar listado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "ndvExecuteUrl": "",
        "jsCode": "// PLACEHOLDER: transformar el listado descargado en un array de ofertas\n// con la MISMA forma del webhook de ingesta (claves en ingles, formato plano):\n// [{ external_id, title, company, salary, location, modality, contract_type,\n//    duration, penalization, description, publication_date, closing_date, source_url }]\n// source debe coincidir con el 'key' de job_sources en la BD.\nreturn [{ external_id: 'PLACEHOLDER-1', title: 'Oferta de ejemplo', company: 'Entidad' }]"
      },
      "id": "code-normalize",
      "name": "Normalizar a formato webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://buscador-inteligente-de-convocatorias.onrender.com/api/webhook/ingest",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "=" + "{{ $env.WEBHOOK_SECRET || 'dev-webhook-secret' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ source: 'empleos-peru' }, $json)) }}"
      },
      "id": "http-post-ingest",
      "name": "Enviar al webhook del backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Cada 12 horas": {
      "main": [[{ "node": "Descargar listado", "type": "main", "index": 0 }]]
    },
    "Descargar listado": {
      "main": [[{ "node": "Normalizar a formato webhook", "type": "main", "index": 0 }]]
    },
    "Normalizar a formato webhook": {
      "main": [[{ "node": "Enviar al webhook del backend", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}