{
  "name": "Ingesta Talento Perú (borrador)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "schedule-talento-peru",
      "name": "Diario 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.gob.pe/empleos (URL real pendiente de validar)",
        "authentication": "none"
      },
      "id": "http-fetch-talento",
      "name": "Descargar página",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sourceMain": "{{ $json.body }}",
        "extractionValues": [
          {
            "fieldName": "title",
            "extractionType": "regex",
            "regex": "PLACEHOLDER: SELECTOR HTML DEL TITULO"
          }
        ]
      },
      "id": "extract-talento",
      "name": "Parsear ofertas (placeholder)",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 2.1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://buscador-inteligente-de-convocatorias.onrender.com/api/webhook/ingest",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "=" + "{{ $env.WEBHOOK_SECRET || 'dev-webhook-secret' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ source: 'empleos-peru', external_id: String($json.title || $json.url).slice(0, 200), title: $json.title, description: $json.body || '' }, $json)) }}"
      },
      "id": "http-post-ingest",
      "name": "Enviar al webhook del backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Diario 06:00": {
      "main": [[{ "node": "Descargar página", "type": "main", "index": 0 }]]
    },
    "Descargar página": {
      "main": [[{ "node": "Parsear ofertas (placeholder)", "type": "main", "index": 0 }]]
    },
    "Parsear ofertas (placeholder)": {
      "main": [[{ "node": "Enviar al webhook del backend", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}