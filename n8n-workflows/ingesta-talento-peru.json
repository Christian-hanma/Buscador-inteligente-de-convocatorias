{
  "name": "Ingesta Talento Perú (borrador)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "schedule-talento-peru",
      "name": "Diario 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.gob.pe/empleos (URL real pendiente de validar)",
        "authentication": "none"
      },
      "id": "http-fetch-talento",
      "name": "Descargar página",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "sourceMain": "{{ $json.body }}",
        "extractionValues": [
          {
            "fieldName": "titulo",
            "extractionType": "regex",
            "regex": "PLACEHOLDER: SELECTOR HTML DEL TITULO"
          }
        ]
      },
      "id": "extract-talento",
      "name": "Parsear ofertas (placeholder)",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 2.1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "amap", "name": "source_key", "value": "=\"talento-peru\"" },
            { "id": "amap2", "name": "offers", "value": "={{ $json.body }}" },
            { "id": "amap3", "name": "raw", "value": "={\"url\":\"{{ $json.url }}\"}" }
          ]
        }
      },
      "id": "normalize-talento",
      "name": "Estandarizar payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/webhook/ingest",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "=" + "{{ $env.WEBHOOK_SECRET || 'cambiar' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_key: $json.source_key, offers: $json.offers, raw: $json.raw }) }}"
      },
      "id": "http-post-ingest",
      "name": "Enviar al webhook del backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Diario 06:00": {
      "main": [[{ "node": "Descargar página", "type": "main", "index": 0 }]]
    },
    "Descargar página": {
      "main": [[{ "node": "Parsear ofertas (placeholder)", "type": "main", "index": 0 }]]
    },
    "Parsear ofertas (placeholder)": {
      "main": [[{ "node": "Estandarizar payload", "type": "main", "index": 0 }]]
    },
    "Estandarizar payload": {
      "main": [[{ "node": "Enviar al webhook del backend", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}