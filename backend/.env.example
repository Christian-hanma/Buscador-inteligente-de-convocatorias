# ===== Servidor =====
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===== Autenticación =====
# IMPORTANTE: cambiar en producción
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# ===== Base de datos (PostgreSQL / Supabase) =====
# Cadena "Direct connection" (puerto 5432) desde
# Supabase → Project Settings → Database → Connection string.
# Ej.: postgresql://postgres.<ref>:<pass>@aws-0-<reg>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Schema donde viven las tablas de la app (no tocar lo que ya existe)
DATABASE_SCHEMA=convocatorias

# ===== OpenAI =====
# Dejar vacío usa el modo mock determinístico (sin costo, para demo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Forzar el modo mock incluso con API key: OPENAI_USE_MOCK=true
OPENAI_USE_MOCK=false

# ===== Webhook de ingesta =====
# Se envía como header x-webhook-secret
WEBHOOK_SECRET=dev-webhook-secret

# ===== Pesos del score final (suma debe ser 100) =====
# JSON opcional que sobrescribe los pesos por defecto
SCORE_WEIGHTS_JSON={"education":20,"experience":25,"skills":25,"location":10,"remuneration":10,"contract":10}